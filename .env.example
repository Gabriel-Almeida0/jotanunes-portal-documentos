# Copie para .env (nunca commite o .env). Gere segredos com: openssl rand -base64 48

# Postgres do compose.yaml
POSTGRES_USER=jotanunes
POSTGRES_PASSWORD=

# Segredo HS256 compartilhado com o Fluig (>= 32 bytes). Usado pela API (Auth__Fluig__Secret)
# e pelo scripts/gerar-token-fluig-dev.mjs.
FLUIG_JWT_SECRET=

# Segredo HS256 dos tokens do portal (>= 32 bytes, diferente do Fluig). API: Auth__Portal__Secret
AUTH_PORTAL_SECRET=

# Resend (opcional em dev: sem chave, os e-mails vão para o log da API)
RESEND_API_KEY=
# Remetente num domínio verificado no Resend. Use aspas: RESEND_FROM="Jotanunes <nao-responda@seu-dominio>"
RESEND_FROM=
