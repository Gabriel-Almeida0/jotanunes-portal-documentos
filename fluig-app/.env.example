# URL da API (backend .NET)
VITE_API_URL=http://localhost:5080
# true = usa os mocks MSW (respostas conforme contracts/openapi.yaml), sem backend
VITE_USE_MOCKS=false
# Somente em desenvolvimento: token Fluig gerado por `node scripts/gerar-token-fluig-dev.mjs` (na raiz)
VITE_FLUIG_DEV_TOKEN=
# Só com VITE_USE_MOCKS=true: perfil do usuário simulado — admin (padrão) ou comum
# (comum = sem ações de cadastro/análise; as rotas de administrador do mock respondem 403 SEM_PERMISSAO)
VITE_MOCK_PERFIL=admin
# Só com VITE_USE_MOCKS=true: true = começa SEM token e mostra a tela de login próprio. Usuários do mock:
# admin.mock/Admin1234 (administrador), comum.mock/Comum1234 (comum), novo.mock/Temp1234 (senha
# provisória → troca obrigatória; nova senha ex.: Nova1234), inativo.mock (desativado) e
# expirado.mock/Temp1234 (senha provisória vencida)
VITE_MOCK_LOGIN=false
