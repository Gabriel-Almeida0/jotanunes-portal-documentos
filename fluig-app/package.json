{
  "name": "jotanunes-fluig-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Área Jotanunes do Portal de Documentação de Terceirizadas (aberta de dentro do Fluig).",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "gen:api": "openapi-typescript ../specs/001-portal-documentos-terceirizadas/contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:css": "node scripts/verificar-sem-framework-css.mjs"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
